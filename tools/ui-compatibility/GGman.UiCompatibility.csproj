<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GGman.UiCompatibility</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FACM/League/ReaLTaiizor/GameRepairView.cs" Link="GameRepairView.cs" />
    <Compile Include="../../src/FACM/League/LeagueGameRepairUiText.cs" Link="LeagueGameRepairUiText.cs" />
    <PackageReference Include="ReaLTaiizor" Version="[3.8.2.1]" />
    <Reference Include="System.Web.Extensions" />
    <None Update="ReaLTaiizor.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
