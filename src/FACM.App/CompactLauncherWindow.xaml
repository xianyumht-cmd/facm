<Window
    x:Class="FACM.App.CompactLauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <Grid Background="{StaticResource FacmBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{StaticResource FacmAccentBrush}"
                CornerRadius="22">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="F"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource FacmAccentTextBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="BrandText"
                    Style="{StaticResource FacmCardTitleTextStyle}" />
                <TextBlock
                    x:Name="ControlCenterText"
                    Style="{StaticResource FacmMutedTextStyle}" />
            </StackPanel>
            <Button
                x:Name="CloseButton"
                Grid.Column="2"
                Width="36"
                Height="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="×"
                automation:AutomationProperties.AutomationId="FACM.Compact.Close" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="16,4,16,12"
            Style="{StaticResource FacmCardBorderStyle}">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="StatusTitle"
                    Style="{StaticResource FacmCardTitleTextStyle}" />
                <TextBlock
                    x:Name="StatusBody"
                    Style="{StaticResource FacmMutedTextStyle}" />
            </StackPanel>
        </Border>

        <Button
            x:Name="RepairButton"
            Grid.Row="2"
            Height="70"
            Margin="16,0,16,12"
            HorizontalAlignment="Stretch"
            Style="{StaticResource FacmPrimaryButtonStyle}"
            automation:AutomationProperties.AutomationId="FACM.Compact.Repair" />

        <Border
            Grid.Row="3"
            Margin="16,0,16,12"
            Style="{StaticResource FacmCardBorderStyle}">
            <StackPanel Spacing="10">
                <Button
                    x:Name="LeagueButton"
                    Height="52"
                    HorizontalAlignment="Stretch"
                    automation:AutomationProperties.AutomationId="FACM.Compact.League" />
                <Button
                    x:Name="PersonalizationButton"
                    Height="52"
                    HorizontalAlignment="Stretch"
                    automation:AutomationProperties.AutomationId="FACM.Compact.Personalization" />
                <Button
                    x:Name="SettingsButton"
                    Height="52"
                    HorizontalAlignment="Stretch"
                    automation:AutomationProperties.AutomationId="FACM.Compact.Settings" />
            </StackPanel>
        </Border>

        <Button
            x:Name="ControlCenterButton"
            Grid.Row="4"
            Height="48"
            Margin="16,0,16,12"
            HorizontalAlignment="Stretch"
            automation:AutomationProperties.AutomationId="FACM.Compact.ControlCenter" />

        <Border
            Grid.Row="5"
            Margin="16,0,16,16"
            VerticalAlignment="Stretch"
            Style="{StaticResource FacmCardBorderStyle}">
            <StackPanel VerticalAlignment="Center" Spacing="6">
                <TextBlock
                    x:Name="FooterTitle"
                    Style="{StaticResource FacmBodyTextStyle}" />
                <TextBlock
                    x:Name="FooterHint"
                    Style="{StaticResource FacmMutedTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
