<Window
    x:Class="FACM.App.FloatingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <Grid
        x:Name="FloatingRoot"
        Width="64"
        Height="64"
        Background="{StaticResource FacmAccentBrush}">
        <Button
            x:Name="FloatingButton"
            Width="64"
            Height="64"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="32"
            Style="{StaticResource FacmPrimaryButtonStyle}"
            automation:AutomationProperties.AutomationId="FACM.Desktop.OpenShell">
            <TextBlock
                Text="F"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource FacmAccentTextBrush}" />
        </Button>
    </Grid>
</Window>
