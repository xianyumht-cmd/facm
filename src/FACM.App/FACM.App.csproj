<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FACM</AssemblyName>
    <RootNamespace>FACM.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\\FACM.ico')">Assets\FACM.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>FACM</Company>
    <Product>FACM Desktop Tools</Product>
    <Description>FACM verified desktop tool launcher</Description>
    <Authors>xianyumht-cmd</Authors>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payloads\payloads.manifest.json" />
    <EmbeddedResource Include="Payloads\*.exe" />
    <EmbeddedResource Include="Payloads\*.bat" />
    <EmbeddedResource Include="Payloads\*.cmd" />
  </ItemGroup>
</Project>
