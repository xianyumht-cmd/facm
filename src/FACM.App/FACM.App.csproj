<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FACM.App</RootNamespace>
    <AssemblyName>FACM.App</AssemblyName>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PetHostBundlePath Condition="'$(PetHostBundlePath)' == ''">$(MSBuildProjectDirectory)\..\..\out\PetHostBundle.zip</PetHostBundlePath>
    <PetHostBundleHashPath Condition="'$(PetHostBundleHashPath)' == ''">$(MSBuildProjectDirectory)\..\..\out\PetHostBundle.sha256</PetHostBundleHashPath>
    <FlyingHostBundlePath Condition="'$(FlyingHostBundlePath)' == ''">$(MSBuildProjectDirectory)\..\..\out\FlyingHostBundle.zip</FlyingHostBundlePath>
    <FlyingHostBundleHashPath Condition="'$(FlyingHostBundleHashPath)' == ''">$(MSBuildProjectDirectory)\..\..\out\FlyingHostBundle.sha256</FlyingHostBundleHashPath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FACM.Core\FACM.Core.csproj" />
    <ProjectReference Include="..\FACM.Infrastructure\FACM.Infrastructure.csproj" />
    <ProjectReference Include="..\FACM.Platform.Windows\FACM.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\FACM\Resources\FACM.ico"
                      LogicalName="FACM.Resources.FACM.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PetHostBundlePath)"
                      Condition="Exists('$(PetHostBundlePath)')"
                      LogicalName="FACM.Resources.PetHost.zip"
                      Type="Non-Resx"
                      WithCulture="false" />
    <EmbeddedResource Include="$(PetHostBundleHashPath)"
                      Condition="Exists('$(PetHostBundleHashPath)')"
                      LogicalName="FACM.Resources.PetHost.sha256"
                      Type="Non-Resx"
                      WithCulture="false" />
    <EmbeddedResource Include="$(FlyingHostBundlePath)"
                      Condition="Exists('$(FlyingHostBundlePath)')"
                      LogicalName="FACM.Resources.FlyingHost.zip"
                      Type="Non-Resx"
                      WithCulture="false" />
    <EmbeddedResource Include="$(FlyingHostBundleHashPath)"
                      Condition="Exists('$(FlyingHostBundleHashPath)')"
                      LogicalName="FACM.Resources.FlyingHost.sha256"
                      Type="Non-Resx"
                      WithCulture="false" />
  </ItemGroup>
  <Target Name="VerifyDesktopPetBundlesBeforeCompile" BeforeTargets="PrepareResourceNames">
    <Error Condition="'$(RequirePetHostBundle)' == 'true' and !Exists('$(PetHostBundlePath)')"
           Text="Required FACM 4.0 VPet PetHost bundle was not built: $(PetHostBundlePath)" />
    <Error Condition="'$(RequirePetHostBundle)' == 'true' and !Exists('$(PetHostBundleHashPath)')"
           Text="Required FACM 4.0 VPet PetHost bundle identity was not built: $(PetHostBundleHashPath)" />
    <Error Condition="'$(RequireFlyingHostBundle)' == 'true' and !Exists('$(FlyingHostBundlePath)')"
           Text="Required FACM 4.0 FlyingHost bundle was not built: $(FlyingHostBundlePath)" />
    <Error Condition="'$(RequireFlyingHostBundle)' == 'true' and !Exists('$(FlyingHostBundleHashPath)')"
           Text="Required FACM 4.0 FlyingHost bundle identity was not built: $(FlyingHostBundleHashPath)" />
    <Message Condition="Exists('$(PetHostBundlePath)')"
             Importance="High"
             Text="Embedding FACM 4.0 VPet PetHost bundle as FACM.Resources.PetHost.zip: $(PetHostBundlePath)" />
    <Message Condition="Exists('$(PetHostBundleHashPath)')"
             Importance="High"
             Text="Embedding FACM 4.0 VPet PetHost identity as FACM.Resources.PetHost.sha256: $(PetHostBundleHashPath)" />
    <Message Condition="Exists('$(FlyingHostBundlePath)')"
             Importance="High"
             Text="Embedding FACM 4.0 FlyingHost bundle as FACM.Resources.FlyingHost.zip: $(FlyingHostBundlePath)" />
    <Message Condition="Exists('$(FlyingHostBundleHashPath)')"
             Importance="High"
             Text="Embedding FACM 4.0 FlyingHost identity as FACM.Resources.FlyingHost.sha256: $(FlyingHostBundleHashPath)" />
  </Target>
</Project>
