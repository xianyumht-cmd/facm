<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FACM.App</RootNamespace>
    <AssemblyName>FACM.App</AssemblyName>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PetHostBundlePath Condition="'$(PetHostBundlePath)' == ''">$(MSBuildProjectDirectory)\..\..\out\PetHostBundle.zip</PetHostBundlePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FACM.Core\FACM.Core.csproj" />
    <ProjectReference Include="..\FACM.Infrastructure\FACM.Infrastructure.csproj" />
    <ProjectReference Include="..\FACM.Platform.Windows\FACM.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PetHostBundlePath)"
                      Condition="Exists('$(PetHostBundlePath)')"
                      LogicalName="FACM.Resources.PetHost.zip"
                      Type="Non-Resx"
                      WithCulture="false" />
  </ItemGroup>
  <Target Name="VerifyPetHostBundleBeforeCompile" BeforeTargets="PrepareResourceNames">
    <Error Condition="'$(RequirePetHostBundle)' == 'true' and !Exists('$(PetHostBundlePath)')"
           Text="Required FACM 4.0 PetHost bundle was not built: $(PetHostBundlePath)" />
    <Message Condition="Exists('$(PetHostBundlePath)')"
             Importance="High"
             Text="Embedding FACM 4.0 PetHost bundle as FACM.Resources.PetHost.zip: $(PetHostBundlePath)" />
  </Target>
</Project>