<Window
    x:Class="FACM.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:local="using:FACM.App">
    <Grid x:Name="SurfaceRoot" Background="{StaticResource FacmBackgroundBrush}">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="SurfaceTransitionTransform" />
        </Grid.RenderTransform>
        <Grid
            x:Name="OrbSurface"
            Width="36"
            Height="36"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            Visibility="Collapsed">
            <Border
                x:Name="OrbSurfaceBorder"
                Width="36"
                Height="36"
                Background="{StaticResource FacmAccentBrush}"
                BorderBrush="{StaticResource FacmStrokeBrush}"
                BorderThickness="1"
                CornerRadius="10,10,10,3">
                <Button
                    x:Name="OrbButton"
                    Width="34"
                    Height="34"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnOrbButtonClick"
                    automation:AutomationProperties.AutomationId="FACM.Surface.Orb">
                    <Path
                        Width="18"
                        Height="18"
                        Stretch="Fill"
                        Fill="{StaticResource FacmAccentTextBrush}"
                        Data="M 2,2 L 16,2 L 16,5 L 6,5 L 6,8 L 14,8 L 14,11 L 6,11 L 6,16 L 2,16 Z" />
                </Button>
            </Border>
            <Border
                x:Name="OrbStatusBadge"
                Width="12"
                Height="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-2,-2,0"
                Background="{StaticResource FacmSuccessBrush}"
                BorderBrush="{StaticResource FacmBackgroundBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="OrbStatusBadgeText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="8"
                    FontWeight="Bold"
                    Foreground="{StaticResource FacmTextPrimaryBrush}" />
            </Border>
        </Grid>

        <Grid
            x:Name="ControlMatrixSurface"
            Width="360"
            Height="286"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{StaticResource FacmBackgroundBrush}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="MatrixTitleBar"
                Grid.Row="0"
                Padding="12,0"
                Background="{StaticResource FacmSurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="MatrixTitle" Style="{StaticResource FacmCardTitleTextStyle}" />
                    <TextBlock x:Name="MatrixStatus" Style="{StaticResource FacmMutedTextStyle}" />
                </StackPanel>
                <Button
                    x:Name="MatrixBackButton"
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Style="{StaticResource FacmToolButtonStyle}"
                    Click="OnSurfaceBackClick"
                    automation:AutomationProperties.AutomationId="FACM.Surface.MatrixBack" />
            </Grid>
            <Grid Grid.Row="1" Padding="10,10,10,8" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="MatrixRepairButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource FacmToolButtonStyle}" Click="OnMatrixRepairClick" automation:AutomationProperties.AutomationId="FACM.Surface.Repair">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7BA;" /><TextBlock x:Name="MatrixRepairLabel" /></StackPanel>
                </Button>
                <Button x:Name="MatrixLeagueButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource FacmToolButtonStyle}" Click="OnMatrixLeagueClick" automation:AutomationProperties.AutomationId="FACM.Surface.League">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE734;" /><TextBlock x:Name="MatrixLeagueLabel" /></StackPanel>
                </Button>
                <Button x:Name="MatrixDiagnosticsButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource FacmToolButtonStyle}" Click="OnMatrixDiagnosticsClick" automation:AutomationProperties.AutomationId="FACM.Surface.Diagnostics">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9D9;" /><TextBlock x:Name="MatrixDiagnosticsLabel" /></StackPanel>
                </Button>
                <Button x:Name="MatrixPetButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource FacmToolButtonStyle}" Click="OnMatrixPersonalizationClick" automation:AutomationProperties.AutomationId="FACM.Surface.Personalization">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE734;" /><TextBlock x:Name="MatrixPetLabel" /></StackPanel>
                </Button>
                <Button x:Name="MatrixSettingsButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource FacmToolButtonStyle}" Click="OnMatrixSettingsClick" automation:AutomationProperties.AutomationId="FACM.Surface.Settings">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE713;" /><TextBlock x:Name="MatrixSettingsLabel" /></StackPanel>
                </Button>
                <Button x:Name="MatrixCleanupButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource FacmToolButtonStyle}" Click="OnMatrixRepairClick" automation:AutomationProperties.AutomationId="FACM.Surface.Cleanup">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" /><TextBlock x:Name="MatrixCleanupLabel" /></StackPanel>
                </Button>
            </Grid>
            <TextBlock
                x:Name="MatrixInspector"
                Grid.Row="2"
                Padding="12,0"
                VerticalAlignment="Center"
                Style="{StaticResource FacmInspectorTextStyle}"
                />
        </Grid>

        <Grid
            x:Name="ChampSelectSurface"
            Width="560"
            Height="62"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{StaticResource FacmSurfaceBrush}"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ChampSelectBackButton"
                Width="34"
                Height="34"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Padding="0"
                Style="{StaticResource FacmToolButtonStyle}"
                Click="OnSurfaceBackClick"
                automation:AutomationProperties.AutomationId="FACM.Surface.ChampSelectBack" />
            <StackPanel
                Grid.Column="1"
                Margin="4,0,4,0"
                VerticalAlignment="Center"
                Spacing="1">
                <TextBlock
                x:Name="ChampSelectStatus"
                    Style="{StaticResource FacmBodyTextStyle}"
                    />
                <TextBlock
                    x:Name="ChampSelectAction"
                    Style="{StaticResource FacmInspectorTextStyle}"
                    />
            </StackPanel>
            <ScrollViewer
                Grid.Column="2"
                Margin="4,0,10,0"
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden">
                <StackPanel
                    x:Name="ChampSelectCandidatesPanel"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center" />
            </ScrollViewer>
        </Grid>

        <Grid x:Name="LegacyFeatureSurface" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource FacmInspectorHeight}" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0"
            Background="{StaticResource FacmSurfaceBrush}"
            BorderBrush="{StaticResource FacmStrokeBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="SurfaceBackButton"
                    Width="30"
                    Height="30"
                    Margin="0,0,8,0"
                    Padding="0"
                    Style="{StaticResource FacmToolButtonStyle}"
                    Click="OnSurfaceBackClick"
                    Visibility="Collapsed"
                    automation:AutomationProperties.AutomationId="FACM.Surface.Back" />
                <TextBlock
                    x:Name="TitleBarText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource FacmCardTitleTextStyle}" />
            </Grid>
        </Border>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="RepairNav" Tag="repair" Style="{StaticResource FacmNavigationItemStyle}" automation:AutomationProperties.AutomationId="FACM.Nav.Repair" />
                <NavigationViewItem x:Name="LeagueNav" Tag="league" Style="{StaticResource FacmNavigationItemStyle}" automation:AutomationProperties.AutomationId="FACM.Nav.League" />
                <NavigationViewItem x:Name="PersonalizationNav" Tag="personalization" Style="{StaticResource FacmNavigationItemStyle}" automation:AutomationProperties.AutomationId="FACM.Nav.Personalization" />
                <NavigationViewItem x:Name="SettingsNav" Tag="settings" Style="{StaticResource FacmNavigationItemStyle}" automation:AutomationProperties.AutomationId="FACM.Nav.Settings" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame">
                <ScrollViewer>
                    <StackPanel
                        Padding="{StaticResource FacmPagePadding}"
                        Spacing="{StaticResource FacmSectionSpacing}"
                        MaxWidth="{StaticResource FacmPageMaxWidth}"
                        HorizontalAlignment="Stretch">

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ProductTitle" Style="{StaticResource FacmPageTitleTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SectionTitle" Style="{StaticResource FacmSectionTitleTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SectionSubtitle" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource FacmCardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="StatusLabel" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                    <TextBlock x:Name="StatusValue" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="CleanupPanel" Visibility="Collapsed" Spacing="{StaticResource FacmSectionSpacing}">
                            <Border Style="{StaticResource FacmCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="RepairToolsTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RepairToolsDescription" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="RepairPrivilegeLabel" Style="{StaticResource FacmBodyTextStyle}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                            <TextBlock
                                                x:Name="RepairPrivilegeStatus"
                                                automation:AutomationProperties.AutomationId="FACM.Repair.Privilege"
                                                Style="{StaticResource FacmBodyTextStyle}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <Button
                                        x:Name="RepairDriverCleanupButton"
                                        automation:AutomationProperties.AutomationId="FACM.Repair.DriverCleanup"
                                        Style="{StaticResource FacmPrimaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="OnRepairDriverCleanupClick" />
                                    <TextBlock x:Name="RepairDriverCleanupHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="RepairToolStatus" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock x:Name="RepairToolDetail" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FacmCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="RepairGameTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RepairGameDescription" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <Button
                                                x:Name="RepairFixWindowButton"
                                                automation:AutomationProperties.AutomationId="FACM.Repair.WindowNow"
                                                Style="{StaticResource FacmPrimaryButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Click="OnRepairFixWindowClick" />
                                            <TextBlock x:Name="RepairFixWindowHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <Button
                                                x:Name="RepairAutoWindowButton"
                                                automation:AutomationProperties.AutomationId="FACM.Repair.AutoWindow"
                                                HorizontalAlignment="Left"
                                                Click="OnRepairAutoWindowClick" />
                                            <TextBlock x:Name="RepairAutoWindowHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <Button
                                                x:Name="RepairSkipSettlementButton"
                                                automation:AutomationProperties.AutomationId="FACM.Repair.SkipSettlement"
                                                HorizontalAlignment="Left"
                                                Click="OnRepairSkipSettlementClick" />
                                            <TextBlock x:Name="RepairSkipSettlementHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <Button
                                                x:Name="RepairRestartClientUxButton"
                                                automation:AutomationProperties.AutomationId="FACM.Repair.RestartClientUx"
                                                HorizontalAlignment="Left"
                                                Click="OnRepairRestartClientUxClick" />
                                            <TextBlock x:Name="RepairRestartClientUxHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                            <Button
                                                x:Name="RepairExitGameButton"
                                                automation:AutomationProperties.AutomationId="FACM.Repair.ExitGame"
                                                HorizontalAlignment="Left"
                                                Click="OnRepairExitGameClick" />
                                            <TextBlock x:Name="RepairExitGameHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                        <TextBlock
                                            x:Name="RepairGameStatus"
                                            automation:AutomationProperties.AutomationId="FACM.Repair.GameStatus"
                                            Style="{StaticResource FacmBodyTextStyle}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FacmCardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="CleanupDirectoryTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CleanupDirectoryDescription" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="CleanupPathText"
                                        automation:AutomationProperties.AutomationId="FACM.Cleanup.GamePath"
                                        Style="{StaticResource FacmBodyTextStyle}"
                                        TextWrapping="Wrap" />
                                    <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="CleanupDirectoryStatus" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock x:Name="CleanupDirectoryDetail" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            x:Name="CleanupDetectButton"
                                            automation:AutomationProperties.AutomationId="FACM.Cleanup.Detect"
                                            Style="{StaticResource FacmPrimaryButtonStyle}"
                                            Click="OnCleanupDetectClick" />
                                        <Button
                                            x:Name="CleanupSelectButton"
                                            automation:AutomationProperties.AutomationId="FACM.Cleanup.Select"
                                            Click="OnCleanupSelectClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FacmCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="CleanupPreviewTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CleanupPreviewDescription" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CleanupSafetyHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    <Button
                                        x:Name="CleanupPreviewButton"
                                        automation:AutomationProperties.AutomationId="FACM.Cleanup.Preview"
                                        Style="{StaticResource FacmPrimaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="OnCleanupPreviewClick" />
                                    <ProgressBar
                                        x:Name="CleanupProgressBar"
                                        automation:AutomationProperties.AutomationId="FACM.Cleanup.Progress"
                                        Visibility="Collapsed"
                                        IsIndeterminate="True" />
                                    <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="CleanupOperationStatus" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid x:Name="GeneralOverviewGrid" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource FacmCardBorderStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="OverviewTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="OverviewBody" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource FacmCardBorderStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="StateTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="StateBody" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="LeagueWorkbenchPanel" Visibility="Collapsed" Spacing="{StaticResource FacmSectionSpacing}">
                            <Border Style="{StaticResource FacmCardBorderStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock x:Name="LeagueStateLabel" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                        <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                            <TextBlock x:Name="LeagueStateValue" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock x:Name="LeagueBudgetLabel" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LeagueBudgetValue" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource FacmCardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="LeagueMatchTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LeagueMatchDescription" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource FacmCardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="LeagueStrategyTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LeagueStrategyDescription" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource FacmCardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="LeagueAutomationTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LeagueAutomationDescription" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                        <ToggleSwitch
                                            x:Name="LeagueAutoMatchmakingToggle"
                                            automation:AutomationProperties.AutomationId="FACM.League.AutoMatchmaking"
                                            Toggled="OnLeagueAutoMatchmakingToggled" />
                                        <TextBlock x:Name="LeagueAutoMatchmakingHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                        <ToggleSwitch
                                            x:Name="LeagueAutoAcceptToggle"
                                            automation:AutomationProperties.AutomationId="FACM.League.AutoAccept"
                                            Toggled="OnLeagueAutoAcceptToggled" />
                                        <TextBlock x:Name="LeagueAutoAcceptHint" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                        <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                            <TextBlock
                                                x:Name="LeagueAutomationSettingsStatus"
                                                automation:AutomationProperties.AutomationId="FACM.League.AutomationSettingsStatus"
                                                Style="{StaticResource FacmBodyTextStyle}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed" Spacing="{StaticResource FacmSectionSpacing}">
                            <Border Style="{StaticResource FacmCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="DiagnosticsTitle" Style="{StaticResource FacmCardTitleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DiagnosticsSubtitle" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DiagnosticsSummaryLabel" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="DiagnosticsSummaryText"
                                        automation:AutomationProperties.AutomationId="FACM.Diagnostics.Summary"
                                        IsReadOnly="True"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="180" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="DiagnosticsRefreshButton" automation:AutomationProperties.AutomationId="FACM.Diagnostics.Refresh" Style="{StaticResource FacmPrimaryButtonStyle}" Click="OnDiagnosticsRefreshClick" />
                                        <Button x:Name="DiagnosticsCopyButton" automation:AutomationProperties.AutomationId="FACM.Diagnostics.Copy" Style="{StaticResource FacmPrimaryButtonStyle}" Click="OnDiagnosticsCopyClick" />
                                        <Button x:Name="DiagnosticsExportButton" automation:AutomationProperties.AutomationId="FACM.Diagnostics.Export" Style="{StaticResource FacmPrimaryButtonStyle}" Click="OnDiagnosticsExportClick" />
                                    </StackPanel>
                                    <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="DiagnosticsStatus" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Frame>
        </NavigationView>

            <local:FacmInspectorBar
                x:Name="InspectorBar"
                Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
