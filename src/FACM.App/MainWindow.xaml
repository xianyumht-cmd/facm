<Window
    x:Class="FACM.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0"
            BorderThickness="0,0,0,1">
            <TextBlock
                x:Name="TitleBarText"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
        </Border>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="RepairNav" Tag="repair" MinHeight="44" AutomationProperties.AutomationId="FACM.Nav.Repair" />
                <NavigationViewItem x:Name="LeagueNav" Tag="league" MinHeight="44" AutomationProperties.AutomationId="FACM.Nav.League" />
                <NavigationViewItem x:Name="PersonalizationNav" Tag="personalization" MinHeight="44" AutomationProperties.AutomationId="FACM.Nav.Personalization" />
                <NavigationViewItem x:Name="SettingsNav" Tag="settings" MinHeight="44" AutomationProperties.AutomationId="FACM.Nav.Settings" />
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" Visibility="Collapsed" />
                <ScrollViewer>
                    <StackPanel
                        Padding="32,28,32,32"
                        Spacing="18"
                        MaxWidth="1040"
                        HorizontalAlignment="Stretch">

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ProductTitle" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SectionTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SectionSubtitle" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Padding="20" CornerRadius="16" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="StatusLabel" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border Padding="10,5" CornerRadius="10" HorizontalAlignment="Left">
                                    <TextBlock x:Name="StatusValue" FontSize="14" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="GeneralOverviewGrid" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="20" CornerRadius="16" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="OverviewTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="OverviewBody" FontSize="14" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Padding="20" CornerRadius="16" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="StateTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="StateBody" FontSize="14" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="LeagueWorkbenchPanel" Visibility="Collapsed" Spacing="18">
                            <Border Padding="20" CornerRadius="16" BorderThickness="1">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock x:Name="LeagueStateLabel" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Border Padding="10,5" CornerRadius="10" HorizontalAlignment="Left">
                                            <TextBlock x:Name="LeagueStateValue" FontSize="14" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock x:Name="LeagueBudgetLabel" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LeagueBudgetValue" FontSize="14" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="20" CornerRadius="16" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="LeagueMatchTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LeagueMatchDescription" FontSize="14" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="20" CornerRadius="16" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="LeagueStrategyTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LeagueStrategyDescription" FontSize="14" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="20" CornerRadius="16" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="LeagueAutomationTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LeagueAutomationDescription" FontSize="14" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed" Spacing="18">
                            <Border Padding="20" CornerRadius="16" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="DiagnosticsTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DiagnosticsSubtitle" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DiagnosticsSummaryLabel" FontSize="14" TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="DiagnosticsSummaryText"
                                        AutomationProperties.AutomationId="FACM.Diagnostics.Summary"
                                        IsReadOnly="True"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="180" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="DiagnosticsRefreshButton" AutomationProperties.AutomationId="FACM.Diagnostics.Refresh" Click="OnDiagnosticsRefreshClick" />
                                        <Button x:Name="DiagnosticsCopyButton" AutomationProperties.AutomationId="FACM.Diagnostics.Copy" Click="OnDiagnosticsCopyClick" />
                                        <Button x:Name="DiagnosticsExportButton" AutomationProperties.AutomationId="FACM.Diagnostics.Export" Click="OnDiagnosticsExportClick" />
                                    </StackPanel>
                                    <Border Padding="10,5" CornerRadius="10" HorizontalAlignment="Left">
                                        <TextBlock x:Name="DiagnosticsStatus" FontSize="14" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
