<Window x:Class="FACM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Microsoft.Windows.Shell;assembly=PresentationFramework"
        Title="FACM"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource AppBackground}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0F1628"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="F" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FACM" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="桌面工具中心" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="—" Click="MinimizeButton_OnClick" />
                    <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0E1526"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <Grid Margin="16,20,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="工作区" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" Margin="8,0,0,10" />
                        <Border Background="#1A2440" CornerRadius="10" Padding="13,11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" FontSize="16" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="工具总览" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Background="#141D31" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="13">
                            <StackPanel>
                                <TextBlock Text="透明运行" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="按需释放 · 哈希校验 · 操作留痕"
                                           Margin="0,5,0,0" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="FACM Rewrite · .NET 8"
                                   Margin="8,12,0,0" FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26,30,30">
                    <TextBlock Text="工具总览" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="选择需要的功能。程序只会释放并运行你主动点击的项目。"
                               FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" />

                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,24,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="内置工具" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="资源在运行前会进行 SHA-256 完整性校验"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#20304E" CornerRadius="12"
                                        Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock x:Name="ToolCountText" Text="0 项" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Border>
                            </DockPanel>

                            <UniformGrid x:Name="ToolsPanel" Columns="2" Margin="-6,17,-6,-6" />

                            <Border x:Name="EmptyToolsPanel" Background="#11192B" CornerRadius="12"
                                    Padding="18" Margin="0,17,0,0" Visibility="Collapsed">
                                <TextBlock Text="尚未接入原程序的内置工具。请把文件加入 Payloads 目录并填写清单。"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="16" Padding="22">
                            <StackPanel>
                                <Border Width="42" Height="42" HorizontalAlignment="Left"
                                        CornerRadius="12" Background="#203554">
                                    <TextBlock Text="⌁" FontSize="22" Foreground="{StaticResource SuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="临时文件维护" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,0" />
                                <TextBlock Text="仅清理 FACM 自身创建的运行缓存、日志和临时文件。"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="CleanCacheButton" Content="检查并清理"
                                            Style="{StaticResource PrimaryButton}" Click="CleanCacheButton_OnClick" />
                                    <Button Content="打开数据目录" Margin="10,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="OpenDataButton_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="16" Padding="22">
                            <StackPanel>
                                <Border Width="42" Height="42" HorizontalAlignment="Left"
                                        CornerRadius="12" Background="#2B2A51">
                                    <TextBlock Text="✓" FontSize="20" Foreground="{StaticResource PrimaryHoverBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="发布可信度" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,0" />
                                <TextBlock Text="正式发布应同时签名主程序与全部内置文件，并保留时间戳。"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" />
                                <Border Background="#11192B" CornerRadius="10" Padding="12,9" Margin="0,18,0,0">
                                    <TextBlock x:Name="SignatureStatusText" Text="当前构建：未验证签名"
                                               FontSize="12" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="16" Padding="22" Margin="0,18,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="运行记录" FontSize="17" FontWeight="SemiBold" />
                                <Button DockPanel.Dock="Right" Content="清空记录" Padding="12,7"
                                        Style="{StaticResource SecondaryButton}" Click="ClearLogButton_OnClick" />
                            </DockPanel>
                            <ListBox x:Name="LogList" Height="150" Margin="0,14,0,0"
                                     Background="#101728" BorderThickness="0"
                                     Foreground="{StaticResource TextSecondary}"
                                     FontFamily="Consolas" FontSize="11" Padding="10" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#0F1628"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Text="仅在用户操作后执行" FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
