<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Keep read-only aliases to WinUI platform brushes for Light/Dark/High Contrast fallback. -->
    <StaticResource x:Key="FacmPlatformBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
    <StaticResource x:Key="FacmPlatformSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
    <StaticResource x:Key="FacmPlatformSurfaceSecondaryBrush" ResourceKey="LayerFillColorDefaultBrush" />
    <StaticResource x:Key="FacmPlatformTextPrimaryBrush" ResourceKey="TextFillColorPrimaryBrush" />
    <StaticResource x:Key="FacmPlatformTextMutedBrush" ResourceKey="TextFillColorSecondaryBrush" />
    <StaticResource x:Key="FacmPlatformAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="FacmPlatformAccentTextBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
    <StaticResource x:Key="FacmPlatformStrokeBrush" ResourceKey="ControlStrokeColorDefaultBrush" />

    <!-- FACM theme brushes are FACM-owned mutable instances. Their colors are supplied by
         WinUiThemeRuntime at startup or copied from the current platform palette in High Contrast.
         Never alias these keys directly to WinUI brushes: protected WinRT brush instances can reject
         Color mutation with E_ACCESSDENIED on real Windows machines. -->
    <SolidColorBrush x:Key="FacmBackgroundBrush" />
    <SolidColorBrush x:Key="FacmSurfaceBrush" />
    <SolidColorBrush x:Key="FacmSurfaceSecondaryBrush" />
    <SolidColorBrush x:Key="FacmTextPrimaryBrush" />
    <SolidColorBrush x:Key="FacmTextMutedBrush" />
    <SolidColorBrush x:Key="FacmAccentBrush" />
    <SolidColorBrush x:Key="FacmAccentTextBrush" />
    <SolidColorBrush x:Key="FacmStrokeBrush" />

    <CornerRadius x:Key="FacmCardCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="FacmControlCornerRadius">14</CornerRadius>
    <Thickness x:Key="FacmPagePadding">32,28,32,32</Thickness>
    <Thickness x:Key="FacmCardPadding">20</Thickness>
    <x:Double x:Key="FacmPageMaxWidth">1040</x:Double>
    <x:Double x:Key="FacmSectionSpacing">18</x:Double>
</ResourceDictionary>
