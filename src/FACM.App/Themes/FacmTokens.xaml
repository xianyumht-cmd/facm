<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semantic aliases intentionally point at WinUI theme resources so Light/Dark/High Contrast
         behavior stays owned by the platform rather than copied into individual pages. -->
    <StaticResource x:Key="FacmBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
    <StaticResource x:Key="FacmSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
    <StaticResource x:Key="FacmSurfaceSecondaryBrush" ResourceKey="LayerFillColorDefaultBrush" />
    <StaticResource x:Key="FacmTextPrimaryBrush" ResourceKey="TextFillColorPrimaryBrush" />
    <StaticResource x:Key="FacmTextMutedBrush" ResourceKey="TextFillColorSecondaryBrush" />
    <StaticResource x:Key="FacmAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="FacmStrokeBrush" ResourceKey="ControlStrokeColorDefaultBrush" />

    <CornerRadius x:Key="FacmCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="FacmControlCornerRadius">10</CornerRadius>
    <Thickness x:Key="FacmPagePadding">32,28,32,32</Thickness>
    <Thickness x:Key="FacmCardPadding">20</Thickness>
    <x:Double x:Key="FacmPageMaxWidth">1040</x:Double>
    <x:Double x:Key="FacmSectionSpacing">18</x:Double>
</ResourceDictionary>
