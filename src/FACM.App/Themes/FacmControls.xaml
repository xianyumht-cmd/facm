<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FacmPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FacmTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FacmSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FacmTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FacmCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FacmTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FacmBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource FacmTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FacmMutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource FacmTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FacmCardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource FacmCardPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource FacmCardCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource FacmSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FacmStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="FacmStatusChipStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="{StaticResource FacmControlCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource FacmSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FacmStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="FacmPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="{StaticResource FacmControlCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource FacmAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource FacmAccentTextBrush}" />
    </Style>

    <Style x:Key="FacmToolButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource FacmCompactControlHeight}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{StaticResource FacmControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <DataTemplate x:Key="FacmToggleTextTemplate">
        <TextBlock
            Text="{Binding}"
            Foreground="{StaticResource FacmTextPrimaryBrush}"
            FontSize="13"
            TextWrapping="Wrap" />
    </DataTemplate>

    <Style x:Key="FacmCollapseButtonStyle" TargetType="Button" BasedOn="{StaticResource FacmToolButtonStyle}">
        <Setter Property="Background" Value="{StaticResource FacmSuccessBrush}" />
        <Setter Property="Foreground" Value="{StaticResource FacmSuccessTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FacmCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource FacmToolButtonStyle}">
        <Setter Property="Background" Value="{StaticResource FacmErrorBrush}" />
        <Setter Property="Foreground" Value="{StaticResource FacmErrorTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FacmToolToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="MinHeight" Value="{StaticResource FacmCompactControlHeight}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource FacmTextPrimaryBrush}" />
        <Setter Property="HeaderTemplate" Value="{StaticResource FacmToggleTextTemplate}" />
        <Setter Property="OnContentTemplate" Value="{StaticResource FacmToggleTextTemplate}" />
        <Setter Property="OffContentTemplate" Value="{StaticResource FacmToggleTextTemplate}" />
    </Style>

    <Style x:Key="FacmInspectorTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource FacmTextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FacmNavigationItemStyle" TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="44" />
    </Style>
</ResourceDictionary>
