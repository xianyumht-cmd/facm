<UserControl
    x:Class="FACM.App.MaintenanceSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="4">
        <Grid Padding="6,4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="更新中心" Style="{StaticResource FacmCardTitleTextStyle}" VerticalAlignment="Center" />
            <ToggleSwitch
                x:Name="AutoUpdateToggle"
                Grid.Column="1"
                Header="启动时自动检查更新"
                automation:AutomationProperties.AutomationId="FACM.Maintenance.AutoUpdate"
                Toggled="OnAutoUpdateToggled" />
        </Grid>
        <Border BorderBrush="{StaticResource FacmStrokeBrush}" BorderThickness="0,0,0,1" />
        <Grid Padding="6,4" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
                <TextBlock Text="当前版本" Style="{StaticResource FacmMutedTextStyle}" />
                <TextBlock x:Name="CurrentVersionText" Style="{StaticResource FacmBodyTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="最新版本" Style="{StaticResource FacmMutedTextStyle}" />
                <TextBlock x:Name="LatestVersionText" Style="{StaticResource FacmBodyTextStyle}" />
            </StackPanel>
            <TextBlock
                x:Name="UpdateStatusText"
                Grid.Column="2"
                automation:AutomationProperties.AutomationId="FACM.Maintenance.Status"
                Style="{StaticResource FacmBodyTextStyle}"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="ReleaseNotesText" Margin="6,0" MaxLines="2" TextTrimming="CharacterEllipsis" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,2">
            <Button x:Name="CheckNowButton" Content="立即检查" automation:AutomationProperties.AutomationId="FACM.Maintenance.CheckNow" Style="{StaticResource FacmPrimaryButtonStyle}" Click="OnCheckNowClick" />
            <Button x:Name="DownloadButton" Content="下载更新" automation:AutomationProperties.AutomationId="FACM.Maintenance.Download" Click="OnDownloadClick" />
            <Button x:Name="CancelDownloadButton" Content="取消下载" automation:AutomationProperties.AutomationId="FACM.Maintenance.CancelDownload" Click="OnCancelDownloadClick" />
            <Button x:Name="InstallButton" Content="安装并重启" automation:AutomationProperties.AutomationId="FACM.Maintenance.Install" Click="OnInstallClick" />
            <Button x:Name="ForceExitButton" Content="退出 FACM" automation:AutomationProperties.AutomationId="FACM.Maintenance.ForceExit" Click="OnForceExitClick" />
        </StackPanel>
        <ProgressBar x:Name="UpdateProgressBar" automation:AutomationProperties.AutomationId="FACM.Maintenance.Progress" Minimum="0" Maximum="100" />
        <TextBlock x:Name="UpdateProgressText" Margin="6,0" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
        <Border BorderBrush="{StaticResource FacmStrokeBrush}" BorderThickness="0,0,0,1" />
        <Grid Padding="6,4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
                <TextBlock Text="公告" Style="{StaticResource FacmCardTitleTextStyle}" />
                <TextBlock x:Name="AnnouncementTitleText" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="AnnouncementBodyText" MaxLines="2" TextTrimming="CharacterEllipsis" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="AnnouncementDetailButton" Grid.Column="1" Content="查看详情" automation:AutomationProperties.AutomationId="FACM.Maintenance.AnnouncementDetail" VerticalAlignment="Center" Click="OnAnnouncementDetailClick" />
        </Grid>
        <Border BorderBrush="{StaticResource FacmStrokeBrush}" BorderThickness="0,0,0,1" />
        <Grid Padding="6,4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
                <TextBlock Text="运行日志" Style="{StaticResource FacmCardTitleTextStyle}" />
                <TextBlock Text="在 FACM 内查看结构化诊断事件。" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="OpenLogButton" Grid.Column="1" Content="打开当前日志" automation:AutomationProperties.AutomationId="FACM.Maintenance.OpenLog" VerticalAlignment="Center" Click="OnOpenLogClick" />
        </Grid>
    </StackPanel>
</UserControl>
