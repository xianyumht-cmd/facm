<UserControl
    x:Class="FACM.App.MaintenanceSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="{StaticResource FacmSectionSpacing}">
        <Border Style="{StaticResource FacmCardBorderStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="更新中心" Style="{StaticResource FacmCardTitleTextStyle}" />
                <ToggleSwitch
                    x:Name="AutoUpdateToggle"
                    Header="启动时自动检查更新"
                    automation:AutomationProperties.AutomationId="FACM.Maintenance.AutoUpdate"
                    Toggled="OnAutoUpdateToggled" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="当前版本" Style="{StaticResource FacmMutedTextStyle}" />
                        <TextBlock x:Name="CurrentVersionText" Style="{StaticResource FacmBodyTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="最新版本" Style="{StaticResource FacmMutedTextStyle}" />
                        <TextBlock x:Name="LatestVersionText" Style="{StaticResource FacmBodyTextStyle}" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource FacmStatusChipStyle}" HorizontalAlignment="Left">
                    <TextBlock
                        x:Name="UpdateStatusText"
                        automation:AutomationProperties.AutomationId="FACM.Maintenance.Status"
                        Style="{StaticResource FacmBodyTextStyle}"
                        TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="ReleaseNotesText" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="CheckNowButton"
                        Content="立即检查"
                        automation:AutomationProperties.AutomationId="FACM.Maintenance.CheckNow"
                        Style="{StaticResource FacmPrimaryButtonStyle}"
                        Click="OnCheckNowClick" />
                    <Button
                        x:Name="DownloadButton"
                        Content="下载更新"
                        automation:AutomationProperties.AutomationId="FACM.Maintenance.Download"
                        Click="OnDownloadClick" />
                    <Button
                        x:Name="CancelDownloadButton"
                        Content="取消下载"
                        automation:AutomationProperties.AutomationId="FACM.Maintenance.CancelDownload"
                        Click="OnCancelDownloadClick" />
                    <Button
                        x:Name="InstallButton"
                        Content="安装并重启"
                        automation:AutomationProperties.AutomationId="FACM.Maintenance.Install"
                        Click="OnInstallClick" />
                    <Button
                        x:Name="ForceExitButton"
                        Content="退出 FACM"
                        automation:AutomationProperties.AutomationId="FACM.Maintenance.ForceExit"
                        Click="OnForceExitClick" />
                </StackPanel>
                <ProgressBar
                    x:Name="UpdateProgressBar"
                    automation:AutomationProperties.AutomationId="FACM.Maintenance.Progress"
                    Minimum="0"
                    Maximum="100" />
                <TextBlock x:Name="UpdateProgressText" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource FacmCardBorderStyle}">
            <StackPanel Spacing="10">
                <TextBlock Text="公告" Style="{StaticResource FacmCardTitleTextStyle}" />
                <TextBlock x:Name="AnnouncementTitleText" Style="{StaticResource FacmBodyTextStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="AnnouncementBodyText" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                <Button
                    x:Name="AnnouncementDetailButton"
                    Content="查看详情"
                    automation:AutomationProperties.AutomationId="FACM.Maintenance.AnnouncementDetail"
                    HorizontalAlignment="Left"
                    Click="OnAnnouncementDetailClick" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource FacmCardBorderStyle}">
            <StackPanel Spacing="10">
                <TextBlock Text="运行日志" Style="{StaticResource FacmCardTitleTextStyle}" />
                <TextBlock Text="打开当前 FACM 4.0 诊断日志。" Style="{StaticResource FacmMutedTextStyle}" TextWrapping="Wrap" />
                <Button
                    x:Name="OpenLogButton"
                    Content="打开当前日志"
                    automation:AutomationProperties.AutomationId="FACM.Maintenance.OpenLog"
                    HorizontalAlignment="Left"
                    Click="OnOpenLogClick" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
