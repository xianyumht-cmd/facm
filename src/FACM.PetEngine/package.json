{
  "name": "facm-pet-engine",
  "version": "1.0.0",
  "private": true,
  "description": "FACM Windows transparent VRM desktop pet engine",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "bundle": "esbuild renderer.js --bundle --platform=browser --format=iife --target=chrome140 --outfile=renderer.bundle.js",
    "pack:win": "npm run bundle && electron-builder --win --dir"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "39.2.6",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.9"
  },
  "build": {
    "appId": "com.facm.petengine",
    "productName": "FACM Pet Engine",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "renderer.bundle.js",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "verifyUpdateCodeSignature": false
    }
  }
}
