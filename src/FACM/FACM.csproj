<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FACM</RootNamespace>
    <AssemblyName>FACM</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\FACM.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ToolBundleAssembly>$(MSBuildProjectDirectory)\..\FACM.ToolBundle\bin\$(Configuration)\net48\FACM.ToolBundle.dll</ToolBundleAssembly>
    <PetHostBundlePath Condition="'$(PetHostBundlePath)' == ''">$(MSBuildProjectDirectory)\..\..\out\PetHostBundle.zip</PetHostBundlePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FACM.ToolBundle\FACM.ToolBundle.csproj" ReferenceOutputAssembly="false" />
    <None Include="Resources\FACM-Canva.png" />

    <!--
      EmbeddedResource 必须在项目加载阶段进入资源项列表。FACM.ToolBundle
      会由上面的 ProjectReference 先构建，随后以固定资源名写入 FACM.exe。
    -->
    <EmbeddedResource Include="$(ToolBundleAssembly)"
                      LogicalName="FACM.Resources.FACM.ToolBundle.dll"
                      Type="Non-Resx"
                      WithCulture="false" />

    <!--
      正式构建会先 publish/self-test PetHost，再把完整 publish 目录压成 ZIP。
      ZIP 直接嵌入 FACM.exe，因此旧版单 EXE 更新器升级后也能恢复匹配版本的 PetHost。
    -->
    <EmbeddedResource Include="$(PetHostBundlePath)"
                      Condition="Exists('$(PetHostBundlePath)')"
                      LogicalName="FACM.Resources.PetHost.zip"
                      Type="Non-Resx"
                      WithCulture="false" />
  </ItemGroup>

  <Target Name="VerifyToolBundleBeforeCompile"
          BeforeTargets="PrepareResourceNames"
          DependsOnTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(ToolBundleAssembly)')"
           Text="FACM.ToolBundle.dll was not built: $(ToolBundleAssembly)" />
    <Message Importance="High"
             Text="Embedding FACM.ToolBundle.dll as FACM.Resources.FACM.ToolBundle.dll" />
  </Target>

  <Target Name="VerifyPetHostBundleBeforeCompile"
          BeforeTargets="PrepareResourceNames">
    <Error Condition="'$(RequirePetHostBundle)' == 'true' and !Exists('$(PetHostBundlePath)')"
           Text="Required PetHost bundle was not built: $(PetHostBundlePath)" />
    <Message Condition="Exists('$(PetHostBundlePath)')"
             Importance="High"
             Text="Embedding PetHost bundle as FACM.Resources.PetHost.zip: $(PetHostBundlePath)" />
  </Target>

  <Target Name="ValidateRuntimeSourcesAfterCiBuild"
          AfterTargets="Build"
          Condition="'$(ContinuousIntegrationBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Message Importance="High" Text="Validating FACM per-pixel-alpha floating ball rendering." />
    <Exec Command="&quot;$(TargetPath)&quot; --floating-ball-test" />
    <Message Importance="High" Text="Validating duplicate-launch activation channel." />
    <Exec Command="&quot;$(TargetPath)&quot; --single-instance-activation-test" />
    <Message Importance="High" Text="Validating FACM built-in roaming animal pets and reset behavior." />
    <Exec Command="&quot;$(TargetPath)&quot; --animal-pet-test" />
    <Message Importance="High" Text="Validating game-locator search budget and cancellation." />
    <Exec Command="&quot;$(TargetPath)&quot; --game-locator-test" />
    <Message Importance="High" Text="Validating Mayhem response-body cancellation after headers arrive." />
    <Exec Command="&quot;$(TargetPath)&quot; --mayhem-body-cancellation-test" />
    <Message Importance="High" Text="Validating Tencent Mayhem patch parsing with an offline fixture." />
    <Exec Command="&quot;$(TargetPath)&quot; --tencent-mayhem-patch-test" />
    <Message Importance="High" Text="Validating complete base ARAM balance parsing with an offline Seraphine fixture." />
    <Exec Command="&quot;$(TargetPath)&quot; --aram-base-balance-test" />
    <Message Condition="Exists('$(PetHostBundlePath)')" Importance="High" Text="Validating embedded PetHost extraction and startup." />
    <Exec Condition="Exists('$(PetHostBundlePath)')" Command="&quot;$(TargetPath)&quot; --embedded-pethost-test" />
  </Target>
</Project>