<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FACM</RootNamespace>
    <AssemblyName>FACM</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\FACM.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FACM.ToolBundle\FACM.ToolBundle.csproj" ReferenceOutputAssembly="false" />
    <None Include="Resources\FACM-Canva.png" />
  </ItemGroup>

  <!--
    ResolveProjectReferences 会先构建 FACM.ToolBundle。将二进制资源放到
    CoreCompile 前加入，保证第一次干净构建时 DLL 已存在，并且 C# 编译器
    能把它以固定 LogicalName 写进最终 FACM.exe。
  -->
  <Target Name="EmbedToolBundle" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <ToolBundleAssembly>$(MSBuildProjectDirectory)\..\FACM.ToolBundle\bin\$(Configuration)\net48\FACM.ToolBundle.dll</ToolBundleAssembly>
    </PropertyGroup>

    <Error Condition="!Exists('$(ToolBundleAssembly)')"
           Text="FACM.ToolBundle.dll was not built: $(ToolBundleAssembly)" />

    <ItemGroup>
      <EmbeddedResource Include="$(ToolBundleAssembly)">
        <LogicalName>FACM.Resources.FACM.ToolBundle.dll</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>

    <Message Importance="High"
             Text="Embedding FACM.ToolBundle.dll as FACM.Resources.FACM.ToolBundle.dll" />
  </Target>
</Project>
