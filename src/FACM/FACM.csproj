<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FACM</RootNamespace>
    <AssemblyName>GGman</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\FACM.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ToolBundleAssembly>$(MSBuildProjectDirectory)\..\FACM.ToolBundle\bin\$(Configuration)\net48\FACM.ToolBundle.dll</ToolBundleAssembly>
    <UpdaterAssembly>$(MSBuildProjectDirectory)\..\FACM.Updater\bin\$(Configuration)\net48\FACM.Updater.exe</UpdaterAssembly>
    <PetHostBundlePath Condition="'$(PetHostBundlePath)' == ''">$(MSBuildProjectDirectory)\..\..\out\PetHostBundle.zip</PetHostBundlePath>
    <IncludePetHostBundle Condition="'$(IncludePetHostBundle)' == '' and '$(RequirePetHostBundle)' == 'true'">true</IncludePetHostBundle>
    <IncludePetHostBundle Condition="'$(IncludePetHostBundle)' == ''">false</IncludePetHostBundle>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FACM.ToolBundle\FACM.ToolBundle.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FACM.Updater\FACM.Updater.csproj" ReferenceOutputAssembly="false" />
    <None Include="Resources\FACM-Canva.png" />
    <EmbeddedResource Include="Resources\real_bee_gate1_v1.png"
                      LogicalName="FACM.Resources.RealBeeGate1.png"
                      Type="Non-Resx"
                      WithCulture="false" />
    <EmbeddedResource Include="$(ToolBundleAssembly)"
                      LogicalName="FACM.Resources.FACM.ToolBundle.dll"
                      Type="Non-Resx"
                      WithCulture="false" />
    <EmbeddedResource Include="$(UpdaterAssembly)"
                      LogicalName="FACM.Resources.FACM.Updater.exe"
                      Type="Non-Resx"
                      WithCulture="false" />
    <EmbeddedResource Include="$(PetHostBundlePath)"
                      Condition="'$(IncludePetHostBundle)' == 'true' and Exists('$(PetHostBundlePath)')"
                      LogicalName="FACM.Resources.PetHost.zip"
                      Type="Non-Resx"
                      WithCulture="false" />
  </ItemGroup>

  <Target Name="VerifyToolBundleBeforeCompile"
          BeforeTargets="PrepareResourceNames"
          DependsOnTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(ToolBundleAssembly)')"
           Text="FACM.ToolBundle.dll was not built: $(ToolBundleAssembly)" />
    <Message Importance="High"
             Text="Embedding FACM.ToolBundle.dll as FACM.Resources.FACM.ToolBundle.dll" />
  </Target>

  <Target Name="VerifyUpdaterBeforeCompile"
          BeforeTargets="PrepareResourceNames"
          DependsOnTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(UpdaterAssembly)')"
           Text="FACM.Updater.exe was not built: $(UpdaterAssembly)" />
    <Message Importance="High"
             Text="Embedding FACM.Updater.exe as FACM.Resources.FACM.Updater.exe" />
  </Target>

  <Target Name="VerifyPetHostBundleBeforeCompile"
          BeforeTargets="PrepareResourceNames">
    <Error Condition="'$(RequirePetHostBundle)' == 'true' and !Exists('$(PetHostBundlePath)')"
           Text="Required PetHost bundle was not built: $(PetHostBundlePath)" />
    <Message Condition="'$(IncludePetHostBundle)' == 'true' and Exists('$(PetHostBundlePath)')"
             Importance="High"
             Text="Embedding explicitly requested PetHost bundle as FACM.Resources.PetHost.zip: $(PetHostBundlePath)" />
  </Target>

  <Target Name="ValidateRuntimeSourcesAfterCiBuild"
          AfterTargets="Build"
          Condition="'$(ContinuousIntegrationBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Message Importance="High" Text="Validating FACM modular host dependency graph and lifecycle." />
    <Exec Command="&quot;$(TargetPath)&quot; --facm-host-test" Timeout="120000" />
    <Message Importance="High" Text="Validating League gameflow cadence, matchmaking reaction and desktop-entry visibility." />
    <Exec Command="&quot;$(TargetPath)&quot; --league-dashboard-test" Timeout="120000" />
    <Message Importance="High" Text="Validating FACM performance budget contract." />
    <Exec Command="&quot;$(TargetPath)&quot; --performance-contract-test" Timeout="120000" />
    <Message Importance="High" Text="Validating FACM update mirror routing, embedded updater and GitHub fallback." />
    <Exec Command="&quot;$(TargetPath)&quot; --update-mirror-test" Timeout="120000" />
    <Message Importance="High" Text="Validating FACM anonymous usage telemetry contract." />
    <Exec Command="&quot;$(TargetPath)&quot; --usage-telemetry-test" Timeout="120000" />
    <Message Importance="High" Text="Validating FACM per-pixel-alpha floating ball rendering." />
    <Exec Command="&quot;$(TargetPath)&quot; --floating-ball-test" Timeout="120000" />
    <Message Importance="High" Text="Validating duplicate-launch activation channel." />
    <Exec Command="&quot;$(TargetPath)&quot; --single-instance-activation-test" Timeout="120000" />
    <Message Importance="High" Text="Validating FACM built-in roaming animal pets and reset behavior." />
    <Exec Command="&quot;$(TargetPath)&quot; --animal-pet-test" Timeout="120000" />
    <Message Importance="High" Text="Validating game-locator search budget and cancellation." />
    <Exec Command="&quot;$(TargetPath)&quot; --game-locator-test" Timeout="120000" />
    <Message Importance="High" Text="Validating Mayhem response-body cancellation after headers arrive." />
    <Exec Command="&quot;$(TargetPath)&quot; --mayhem-body-cancellation-test" Timeout="120000" />
    <Message Importance="High" Text="Validating Tencent Mayhem patch parsing with an offline fixture." />
    <Exec Command="&quot;$(TargetPath)&quot; --tencent-mayhem-patch-test" Timeout="120000" />
    <Message Importance="High" Text="Validating complete base ARAM balance parsing with an offline Seraphine fixture." />
    <Exec Command="&quot;$(TargetPath)&quot; --aram-base-balance-test" Timeout="120000" />
    <Message Condition="'$(IncludePetHostBundle)' == 'true' and Exists('$(PetHostBundlePath)')" Importance="High" Text="Validating embedded PetHost extraction and startup." />
    <Exec Condition="'$(IncludePetHostBundle)' == 'true' and Exists('$(PetHostBundlePath)')" Command="&quot;$(TargetPath)&quot; --embedded-pethost-test" Timeout="180000" />
  </Target>
</Project>