<Window x:Class="FACM.Presentation.IosGlass.IosGlassControlCenter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GGman" Width="408" Height="448"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="Microsoft YaHei UI" SnapsToDevicePixels="True"
        Deactivated="OnDeactivated" KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="GlassTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GlassTileBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="21" Padding="16">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassFooter" TargetType="Button" BasedOn="{StaticResource GlassTile}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border Margin="14" CornerRadius="29"
            Background="{DynamicResource GlassBackgroundBrush}"
            BorderBrush="{DynamicResource GlassOuterBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="8" Opacity="0.43" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="17">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="13"/>
                <RowDefinition Height="43"/>
                <RowDefinition Height="15"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="14"
                        Background="{DynamicResource GlassAccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="G" Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GGman" FontSize="23" FontWeight="SemiBold"
                               Foreground="{DynamicResource GlassTextBrush}"/>
                    <TextBlock Text="控制中心" FontSize="11" Margin="1,1,0,0"
                               Foreground="{DynamicResource GlassSecondaryTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GlassFooter}" Width="36" Height="36"
                        Tag="close" Click="OnActionClick" ToolTip="收起" Content="×"
                        AutomationProperties.Name="收起控制中心"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Margin="0,0,6,6" Style="{StaticResource GlassTile}"
                        Tag="dashboard" Click="OnActionClick" AutomationProperties.Name="打开工作台">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⌂" FontSize="28" FontFamily="Segoe UI Symbol"
                                   Foreground="{DynamicResource GlassAccentBrush}"/>
                        <TextBlock x:Name="DashboardText" Text="工作台" FontWeight="SemiBold" FontSize="17" Margin="0,8,0,2"/>
                        <TextBlock Text="当前状态与功能" FontSize="11"
                                   Foreground="{DynamicResource GlassSecondaryTextBrush}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Margin="6,0,0,6" Style="{StaticResource GlassTile}"
                        Tag="matches" Click="OnActionClick" AutomationProperties.Name="打开战绩">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="▥" FontSize="25" FontFamily="Segoe UI Symbol"
                                   Foreground="{DynamicResource GlassAccentBrush}"/>
                        <TextBlock x:Name="MatchesText" Text="战绩" FontWeight="SemiBold" FontSize="17" Margin="0,9,0,2"/>
                        <TextBlock Text="游戏与玩家记录" FontSize="11"
                                   Foreground="{DynamicResource GlassSecondaryTextBrush}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Margin="0,6,6,0" Style="{StaticResource GlassTile}"
                        Tag="guides" Click="OnActionClick" AutomationProperties.Name="打开海斗攻略">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="✧" FontSize="28" FontFamily="Segoe UI Symbol"
                                   Foreground="{DynamicResource GlassAccentBrush}"/>
                        <TextBlock x:Name="GuidesText" Text="海斗攻略" FontWeight="SemiBold" FontSize="17" Margin="0,8,0,2"/>
                        <TextBlock Text="英雄与强化建议" FontSize="11"
                                   Foreground="{DynamicResource GlassSecondaryTextBrush}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Margin="6,6,0,0" Style="{StaticResource GlassTile}"
                        Tag="tools" Click="OnActionClick" AutomationProperties.Name="打开游戏修复">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="27" FontFamily="Segoe UI Symbol"
                                   Foreground="{DynamicResource GlassAccentBrush}"/>
                        <TextBlock x:Name="ToolsText" Text="游戏修复" FontWeight="SemiBold" FontSize="17" Margin="0,8,0,2"/>
                        <TextBlock Text="诊断与维护入口" FontSize="11"
                                   Foreground="{DynamicResource GlassSecondaryTextBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource GlassFooter}"
                        Tag="theme" Click="OnActionClick" AutomationProperties.Name="选择主题">
                    <TextBlock x:Name="ThemeText" Text="主题"/>
                </Button>
                <Button Grid.Column="1" Margin="4,0,4,0" Style="{StaticResource GlassFooter}"
                        Tag="updates" Click="OnActionClick" AutomationProperties.Name="检查更新">
                    <TextBlock x:Name="UpdateText" Text="检查更新"/>
                </Button>
                <Button Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource GlassFooter}"
                        Tag="logs" Click="OnActionClick" AutomationProperties.Name="打开日志">
                    <TextBlock x:Name="LogsText" Text="日志"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
