<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UpdaterPayloadPath Condition="'$(UpdaterPayloadPath)' == ''">$(MSBuildProjectDirectory)\..\..\out\FACM.Updater.exe</UpdaterPayloadPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FACM.Core\FACM.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\clean driver.exe">
      <LogicalName>FACM.Platform.Windows.Resources.DriverCleanup</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(UpdaterPayloadPath)"
                      Condition="Exists('$(UpdaterPayloadPath)')"
                      LogicalName="FACM.Platform.Windows.Resources.FACM.Updater.exe" />
  </ItemGroup>
  <Target Name="VerifyUpdaterPayloadBeforeCompile" BeforeTargets="PrepareResourceNames">
    <Error Condition="'$(RequireUpdaterPayload)' == 'true' and !Exists('$(UpdaterPayloadPath)')"
           Text="Required FACM updater payload was not built: $(UpdaterPayloadPath)" />
    <Message Condition="Exists('$(UpdaterPayloadPath)')"
             Importance="High"
             Text="Embedding FACM updater payload: $(UpdaterPayloadPath)" />
  </Target>
</Project>
